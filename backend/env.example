# Copy this file to ".env" in the same folder and fill in your own values.
# Never commit the actual ".env" file — it's already in .gitignore.

# Your PostgreSQL connection string
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL="postgresql://postgres:password@localhost:5432/roxiler_db"

# Any long random string — used to sign login tokens
JWT_SECRET="replace-this-with-a-long-random-secret"

# Port the backend server runs on
PORT=5000
